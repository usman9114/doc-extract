# Which LLM backend to use: openrouter | anthropic | openai
LLM_PROVIDER=openrouter
# Model id for that provider (OpenRouter ids look like vendor/model)
LLM_MODEL=anthropic/claude-haiku-4.5
# Extraction mode used by the API/UI: text (OCR -> LLM) or vision (image -> LLM)
EXTRACT_MODE=text

OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: append results to a Google Sheet (service account JSON + sheet id)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
