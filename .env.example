# Which LLM backend to use: zai | openrouter | anthropic | openai
LLM_PROVIDER=zai
# Model ids for that provider. Leave empty for the provider default
# (zai: glm-4.5-flash for text, glm-4.6v-flash for images; both free).
LLM_MODEL=
LLM_VISION_MODEL=
# Extraction mode used by the API/UI: text (OCR -> LLM) or vision (image -> LLM)
EXTRACT_MODE=text

ZAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: append results to a Google Sheet (service account JSON + sheet id)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
